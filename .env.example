# ─────────────────────────────────────────────────────────────
# GEO Tracker — omgevingsvariabelen
# Kopieer dit bestand naar `.env.local` en vul de echte waarden in.
# `.env.local` staat in .gitignore en wordt NOOIT gecommit.
# In productie zet je deze in Vercel (Project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Project URL en anon key: Supabase Dashboard → Project Settings → API.
# Deze twee zijn NEXT_PUBLIC_ omdat de browser-client ze nodig heeft (veilig: anon key is publiek).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: ZELFDE pagina, "service_role" secret.
# ⚠️ SERVER-ONLY. Nooit NEXT_PUBLIC_ maken, nooit naar de browser sturen.
# Alle schrijfacties lopen via API-routes met deze key (zie abcplan.md §5, §12.20).
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=
# De modelkeuze (gpt-4.1-nano / gpt-4.1-mini) staat vast in de code
# (lib/openai/models.ts), NIET als env-variabele. Zie abcplan.md §2.

# ── Resend (rapport-e-mail, Fase B) ───────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=GEO Tracker <onboarding@resend.dev>

# ── App ───────────────────────────────────────────────────────
# Publieke basis-URL van de app (voor mail-links e.d.).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Gedeeld geheim dat de cron-endpoints beschermt (Vercel Cron stuurt dit mee).
# Ook nodig voor de werker (/api/cron/worker), die de wachtrij afwerkt.
CRON_SECRET=

# Hoeveel wandkloktijd de werker zichzelf per aanroep gunt, in milliseconden.
# Moet ruim onder de tijdslimiet van de route blijven. Standaard 40000 (past bij
# maxDuration = 60). Kapt jouw platform eerder af, zet 'm dan lager — te laag is
# ongevaarlijk (de volgende aanroep gaat verder), te hoog niet.
WORKER_TIME_BUDGET_MS=40000

# Publieke registratie via de app. Laat op 'false' (of weg) tijdens de bouwfase:
# dan kan niemand een account aanmaken. Zet op 'true' bij lancering.
# ⚠️ Dit is de app-laag; de harde poort is de Supabase-instelling
# "Allow new users to sign up" (zie SETUP.md).
SIGNUPS_ENABLED=false

# Grounding (web_search) in de MÉTING (halte A3). Standaard aan.
# Zet op 'false' in de ontwikkelomgeving om de dure web_search-tool uit te zetten:
# de AI antwoordt dan uit eigen kennis i.p.v. live internet — flink goedkoper.
# ⚠️ NIET op 'false' in productie: dan wordt de meting onrealistisch.
MEASURE_WEB_SEARCH=true
