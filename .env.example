# ─────────────────────────────────────────────────────────────
# GEO Tracker — omgevingsvariabelen
# Kopieer dit bestand naar `.env.local` en vul de echte waarden in.
# `.env.local` staat in .gitignore en wordt NOOIT gecommit.
# In productie zet je deze in Vercel (Project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Project URL en anon key: Supabase Dashboard → Project Settings → API.
# Deze twee zijn NEXT_PUBLIC_ omdat de browser-client ze nodig heeft (veilig: anon key is publiek).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: ZELFDE pagina, "service_role" secret.
# ⚠️ SERVER-ONLY. Nooit NEXT_PUBLIC_ maken, nooit naar de browser sturen.
# Alle schrijfacties lopen via API-routes met deze key (zie abcplan.md §5, §12.20).
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=
# De modelkeuze (gpt-4.1-nano / gpt-4.1-mini) staat vast in de code
# (lib/openai/models.ts), NIET als env-variabele. Zie abcplan.md §2.

# ── Resend (rapport-e-mail, Fase B) ───────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=GEO Tracker <onboarding@resend.dev>

# ── App ───────────────────────────────────────────────────────
# Publieke basis-URL van de app (voor mail-links e.d.).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Gedeeld geheim dat de cron-endpoints beschermt (Vercel Cron stuurt dit mee). Sprint 4.
CRON_SECRET=
